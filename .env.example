# FORGE Business OS — repo-root environment variables.
#
# Shared by: the Prisma CLI (migrations/seed, run from the repo root) and
# apps/api (which has no .env of its own — see apps/api/src/app.module.ts).
# apps/web has its own env file: apps/web/.env.example.
#
# Separation of development / test / production is via NODE_ENV, not three
# physical files — the same variables apply in every environment, only
# their values differ, and each deployment target (local dev, CI, prod)
# supplies its own real .env or platform-level secret injection. Never
# commit a real .env for any environment.

# --- Database (Document 4: Database Migration Guide) ------------------------

# PostgreSQL connection for FORGE Business OS (greenfield backend).
# Never point this at the marketing-site Supabase contact_submissions project
# unless that database has been explicitly designated for Business OS.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/forge_business_os?schema=public"

# Application DB role name used by the NestJS app at runtime.
# Migration step REVOKE UPDATE, DELETE ON audit_logs must target this role.
APP_DB_ROLE="forge_app"

# --- apps/api (Implementation Phase 0) ---------------------------------------

# development | test | production
NODE_ENV="development"

# apps/api listens on this port. The API is always served under the frozen
# /api/v1 prefix (Document 5 §2.1) regardless of port.
PORT=4000

# Comma-separated list of origins allowed to call the API with credentials
# (Document 6 §5 — httpOnly session cookies require CORS credentials to be
# explicit, not "*"). Include apps/web's dev server origin locally.
CORS_ORIGINS="http://localhost:3000"

# --- apps/api (Implementation Phase 1 — auth/RBAC/session) ------------------

# REQUIRED, no built-in default — the app refuses to boot without this
# (env.validation.ts). Must be >=32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotate with an invalidation plan in production (Document 6 §20) — rotating
# this value invalidates every existing session immediately (all tokens
# fail signature verification).
SESSION_JWT_SIGNING_KEY=

# Document 6 §5.2 item 1 — exact TTL NOT CURRENTLY DEFINED; default below
# is a development convenience (12h), not a claimed production value.
SESSION_JWT_TTL_SECONDS=43200

# Cookie `Secure` flag — defaults to true in production / false otherwise
# if unset. Document 6 §5.2 item 5 treats Secure-in-production as
# mandatory but doesn't freeze the toggle mechanism.
# B9: COOKIE_SECURE=false is rejected at boot when NODE_ENV=production.
# COOKIE_SECURE=true

# Cookie `Domain` — Document 6 §5.2 item 5, NOT CURRENTLY DEFINED. Left
# unset (host-only cookie) unless a specific value is required.
# COOKIE_DOMAIN=

# Reverse-proxy hop count for Express `trust proxy` (F10.4).
# Production defaults to 1 (single TLS terminator / load balancer) when unset.
# Development/test default to disabled (direct connections).
# Do NOT set `true` (trust every hop). Use an integer 1–5, or `false`/`0` to disable.
# TRUST_PROXY=1

# B8 DomainEvent outbox worker — in-process poller. Disabled automatically
# when NODE_ENV=test. Set to false to disable in staging/production if a
# separate worker process is introduced later (not required for single-instance).
# DOMAIN_EVENT_WORKER_ENABLED=true

# B9 legacy: optional HMAC secret for the retired stub StorageService.
# Unused when R2_* credentials are configured (F10.2 uses SigV4 presigning).
# STORAGE_SIGNING_SECRET=

# Cloudflare R2 — document object storage (Doc 6 §11 / F10.2).
# All four required together for document upload/download. When unset,
# document presign/register/download return 503 STORAGE_NOT_CONFIGURED
# (app still boots — same pattern as Razorpay). Never expose these to the browser.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# bcrypt cost factor — not frozen by Document 6 §3; see password.service.ts.
PASSWORD_HASH_COST_FACTOR=12

# Document 6 §7 — within the frozen "15-30 min" range; exact value NOT
# CURRENTLY DEFINED beyond that range.
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800

# Document 6 §6.2/§26 item 7 — Document 1's own example ("e.g. 7 days"),
# not a frozen production constant.
INVITATION_TOKEN_TTL_DAYS=7

# Rate limiting (Document 6 §14 — every number below is explicitly NOT
# CURRENTLY DEFINED as a production constant; these are configurable
# defaults). In-memory per-process (@nestjs/throttler) — no Redis.
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_INVITATION_ACCEPT_MAX=5
RATE_LIMIT_INVITATION_ACCEPT_WINDOW_SECONDS=60
RATE_LIMIT_PASSWORD_RESET_MAX=3
RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=300

# --- Google Workspace SSO (Document 6 §4.1 — the only internal IdP) --------
# All optional: unset means the /auth/google/* endpoints respond 503
# rather than the app failing to boot. Exact values are environment-level
# configuration, not frozen by Document 6.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# --- Integrations (Document 6 §20) ------------------------------------------
# Optional: modules return clear "not configured" errors when unset.

# Portal identity's own JWT audience (Document 6 §5.1) — portal uses
# SESSION_JWT_SIGNING_KEY with aud=portal; this remains unused.
# PORTAL_JWT_SIGNING_KEY=

# Razorpay (Doc 6 §12, §20)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Resend — transactional email (Doc 6 §20 / F10.3). Both required together
# for invitation and password-reset emails to actually send. When unset,
# those flows still work fully (invitation/token created, generic
# anti-enumeration responses) but delivery is skipped and reported as such
# (app still boots — same pattern as Razorpay/R2). Never expose to the browser.
# RESEND_API_KEY=
# Verified sender, e.g. "FORGE <noreply@forgebuilds.in>" — must be a real,
# domain-verified Resend sender; never a fake/development address.
# EMAIL_FROM=
