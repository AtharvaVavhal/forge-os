# PostgreSQL connection for FORGE Business OS (greenfield backend).
# Never point this at the marketing-site Supabase contact_submissions project
# unless that database has been explicitly designated for Business OS.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/forge_business_os?schema=public"

# Application DB role name used by the NestJS app at runtime.
# Migration step REVOKE UPDATE, DELETE ON audit_logs must target this role.
APP_DB_ROLE="forge_app"
