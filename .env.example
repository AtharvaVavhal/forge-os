# FORGE Business OS — repo-root environment variables.
#
# Shared by: the Prisma CLI (migrations/seed, run from the repo root) and
# apps/api (which has no .env of its own — see apps/api/src/app.module.ts).
# apps/web has its own env file: apps/web/.env.example.
#
# Separation of development / test / production is via NODE_ENV, not three
# physical files — the same variables apply in every environment, only
# their values differ, and each deployment target (local dev, CI, prod)
# supplies its own real .env or platform-level secret injection. Never
# commit a real .env for any environment.

# --- Database (Document 4: Database Migration Guide) ------------------------

# PostgreSQL connection for FORGE Business OS (greenfield backend).
# Never point this at the marketing-site Supabase contact_submissions project
# unless that database has been explicitly designated for Business OS.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/forge_business_os?schema=public"

# Application DB role name used by the NestJS app at runtime.
# Migration step REVOKE UPDATE, DELETE ON audit_logs must target this role.
APP_DB_ROLE="forge_app"

# --- apps/api (Implementation Phase 0) ---------------------------------------

# development | test | production
NODE_ENV="development"

# apps/api listens on this port. The API is always served under the frozen
# /api/v1 prefix (Document 5 §2.1) regardless of port.
PORT=4000

# Comma-separated list of origins allowed to call the API with credentials
# (Document 6 §5 — httpOnly session cookies require CORS credentials to be
# explicit, not "*"). Include apps/web's dev server origin locally.
CORS_ORIGINS="http://localhost:3000"

# --- Phase 1+ (Document 6 §20 "Secrets") — NOT CURRENTLY DEFINED ------------
# Listed here so the full secret surface is visible ahead of time, but NONE
# of these are read by any Phase 0 code. Do not fill these in until the
# module that needs them is actually implemented, and never commit real
# values even then — production secrets belong in a secret manager.

# Session/JWT signing keys (separate audiences: internal vs portal, Doc 6 §5)
# SESSION_JWT_SIGNING_KEY=
# PORTAL_JWT_SIGNING_KEY=

# Google Workspace SSO (Doc 6 §4.1 — the only internal IdP)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Razorpay (Doc 6 §12, §20)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Cloudflare R2 — document storage (Doc 6 §11)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# Resend — transactional email (Doc 6 §20)
# RESEND_API_KEY=
