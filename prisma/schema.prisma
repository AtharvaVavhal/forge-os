// ─── K11/K12 — Project allocation & team payouts ────────────────────────────
// Revenue/expenses/distributable are never stored on Project — always
// derived from Payment/Refund/Expense (see ProjectFinancialsService) and
// frozen onto a ProjectAllocation row only at approval time. Cumulative
// approved-total-vs-distributable-pool is a cross-row invariant spanning
// every APPROVED ProjectAllocation for a project — NOT expressible as a
// Postgres row-level CHECK constraint — so it is enforced transactionally
// in the service layer (SELECT ... FOR UPDATE on the Project row), the same
// way every other cross-row financial invariant in this schema is enforced
// (see payments.service.ts / refunds.service.ts). ForgeFundEntry remains
// Forge-level fund movement only — this is a deliberately separate ledger.

/// One allocation "round" for a project. revenue/expenses/distributable
/// snapshots are null while DRAFT (computed live on every read) and frozen
/// permanently at the moment of approval. Corrections are new rows via
/// adjustment_of_id — an approved round is never mutated.
model ProjectAllocation {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id        String                  @db.Uuid
  project_id             String                  @db.Uuid
  status                 ProjectAllocationStatus @default(DRAFT)
  adjustment_of_id       String?                 @db.Uuid
  revenue_snapshot       Decimal?                @db.Decimal(12, 2)
  expenses_snapshot      Decimal?                @db.Decimal(12, 2)
  distributable_snapshot Decimal?                @db.Decimal(12, 2)
  /// Cached SUM of this round's lines — signed (a correction round's total
  /// may be negative). Kept in sync transactionally on every line mutation.
  total_allocated        Decimal                 @default(0) @db.Decimal(12, 2)
  created_by             String                  @db.Uuid
  approved_by            String?                 @db.Uuid
  approved_at            DateTime?               @db.Timestamptz(6)
  cancelled_at           DateTime?               @db.Timestamptz(6)
  version                Int                     @default(1)
  created_at             DateTime                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                @updatedAt @db.Timestamptz(6)

  organization  Organization        @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  project       Project             @relation(fields: [project_id], references: [id], onDelete: Restrict)
  creator       User                @relation("ProjectAllocationCreatedBy", fields: [created_by], references: [id], onDelete: Restrict)
  approver      User?               @relation("ProjectAllocationApprovedBy", fields: [approved_by], references: [id], onDelete: Restrict)
  adjustment_of ProjectAllocation?  @relation("ProjectAllocationAdjustments", fields: [adjustment_of_id], references: [id], onDelete: Restrict)
  adjustments   ProjectAllocation[] @relation("ProjectAllocationAdjustments")
  lines         ProjectAllocationLine[]

  @@index([organization_id, project_id])
  @@index([organization_id, status])
  @@index([created_by])
  @@index([approved_by])
  @@index([adjustment_of_id])
  @@map("project_allocations")
}

/// One member's amount within an allocation round. amount is SIGNED
/// (positive = credit, negative = clawback — negative only valid within an
/// adjustment round). Immutable once the parent round is APPROVED — never
/// UPDATE a line after that; corrections are new lines in a new round.
model ProjectAllocationLine {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id        String   @db.Uuid
  project_allocation_id  String   @db.Uuid
  user_id                String   @db.Uuid
  amount                 Decimal  @db.Decimal(12, 2)
  note                   String?  @db.Text
  created_at             DateTime @default(now()) @db.Timestamptz(6)
  updated_at             DateTime @updatedAt @db.Timestamptz(6)

  organization       Organization      @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  project_allocation ProjectAllocation @relation(fields: [project_allocation_id], references: [id], onDelete: Restrict)
  user               User              @relation("ProjectAllocationLineUser", fields: [user_id], references: [id], onDelete: Restrict)

  @@unique([organization_id, project_allocation_id, user_id])
  @@index([organization_id, project_allocation_id])
  @@index([organization_id, user_id])
  @@map("project_allocation_lines")
}

/// A member's withdrawal request. destination_snapshot is a point-in-time
/// copy of PayoutProfile at request creation — full values (Finance needs
/// them to actually pay; masked only in UI) — and is never mutated after
/// creation, even if the member later changes their PayoutProfile.
model TeamPayoutRequest {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id        String            @db.Uuid
  user_id                String            @db.Uuid
  amount                 Decimal           @db.Decimal(12, 2)
  status                 TeamPayoutStatus  @default(REQUESTED)
  payout_method          PayoutMethod
  destination_snapshot   Json
  requested_at           DateTime          @default(now()) @db.Timestamptz(6)
  reviewed_by            String?           @db.Uuid
  reviewed_at            DateTime?         @db.Timestamptz(6)
  approved_by            String?           @db.Uuid
  approved_at            DateTime?         @db.Timestamptz(6)
  processing_started_at  DateTime?         @db.Timestamptz(6)
  processor              String?
  paid_at                DateTime?         @db.Timestamptz(6)
  rejected_at            DateTime?         @db.Timestamptz(6)
  rejection_reason       String?           @db.Text
  failure_reason         String?           @db.Text
  external_reference     String?
  version                Int               @default(1)
  created_at             DateTime          @default(now()) @db.Timestamptz(6)
  updated_at             DateTime          @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user         User         @relation("TeamPayoutRequestUser", fields: [user_id], references: [id], onDelete: Restrict)
  reviewer     User?        @relation("TeamPayoutReviewedBy", fields: [reviewed_by], references: [id], onDelete: Restrict)
  approver     User?        @relation("TeamPayoutApprovedBy", fields: [approved_by], references: [id], onDelete: Restrict)

  @@index([organization_id, user_id])
  @@index([organization_id, status])
  @@index([reviewed_by])
  @@index([approved_by])
  @@map("team_payout_requests")
}

// ─── Bank directory (K10; shared reference data — no organization_id) ───────

/// Read-only IFSC/branch directory imported from an external dataset via
/// prisma/import-bank-directory.ts. Never holds account numbers, account
/// holder names, or any other payout/KYC data — see PayoutProfile for that.
model BankDirectoryEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bank_name   String
  /// 4-letter IFSC prefix (e.g. "HDFC") — denormalized from `ifsc` at import time.
  bank_code   String
  ifsc        String   @unique
  branch_name String
  address     String
  city        String
  /// Source dataset's "CITY2" column — the branch's district, not its city.
  district    String?
  state       String
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  @@index([bank_name])
  @@index([bank_code])
  @@map("bank_directory_entries")
}
