// FORGE Business OS — Production Prisma Schema
// Source of truth: Architecture Red-Team Review (Doc 1) + Database Specification Frozen v1 (Doc 2)
// Conflict resolutions (frozen):
//   1. Invoice/Payment: NO soft-delete — VOID/CANCELLED and REVERSED only
//   2. Project: NO archived_at/deleted_at — lifecycle statuses only
//   3. CreditNoteSequence: explicit FY-scoped counter, separate from InvoiceSequence
//
// Do not add product features. Do not redesign the entity model.
// Constraints Prisma cannot express (polymorphic CHECKs, partial uniques, AuditLog REVOKE,
// GIN FTS) live in prisma/sql/ and must be applied as hand-edited migration steps.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  FOUNDER_ADMIN
  OPERATIONS
  FINANCE
  SALES
  TEAM_MEMBER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  DISQUALIFIED
}

enum LeadSource {
  REFERRAL
  INBOUND_FORM
  COLD_OUTREACH
  LINKEDIN
  PAST_CLIENT
  EVENT
  OTHER
}

enum DealStage {
  NEW
  CONTACTED
  QUALIFIED
  DISCOVERY
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum DealLostReason {
  PRICE
  TIMING
  CHOSE_COMPETITOR
  NO_BUDGET
  GHOSTED
  NOT_A_FIT
  OTHER
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  AT_RISK
  COMPLETED
  CANCELLED
}

enum ProjectPhase {
  PLANNING
  DESIGN
  DEVELOPMENT
  QA
  CLIENT_REVIEW
  DEPLOYMENT
  HANDOVER
  COMPLETED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  AWAITING_APPROVAL
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum PaymentMethod {
  RAZORPAY
  CASH
  BANK_TRANSFER
  CHEQUE
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum CreditNoteReason {
  SCOPE_REDUCTION
  PRICING_ERROR
  CANCELLATION
  GOODWILL
  OTHER
}

enum ForgeFundEntryType {
  CONTRIBUTION
  WITHDRAWAL
  ALLOCATION
}

enum MaintenanceStatus {
  ACTIVE
  EXPIRED
  RENEWED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CLIENT
  RESOLVED
  CLOSED
  REOPENED
}

enum DocumentCategory {
  PROPOSAL
  CONTRACT
  INVOICE
  RECEIPT
  HANDOVER
  REQUIREMENT
  CLIENT_ASSET
  INTERNAL
}

enum Visibility {
  INTERNAL
  CLIENT_VISIBLE
}

enum TaxTreatment {
  CGST_SGST
  IGST
  EXEMPT
}

enum ActorType {
  USER
  CLIENT_USER
  SYSTEM
}

enum RecipientType {
  USER
  CLIENT_USER
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum InvitationScope {
  TEAM
  CLIENT
}

enum WebhookSource {
  RAZORPAY
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum DomainEventStatus {
  PENDING
  PROCESSED
  FAILED
}

enum KycStatus {
  NOT_STARTED
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum KycGovernmentIdType {
  AADHAAR
  PASSPORT
  DRIVING_LICENCE
  VOTER_ID
  OTHER
}

enum KycDocumentType {
  PAN_CARD
  GOVERNMENT_ID
}

enum KycDocumentStatus {
  UPLOADED
  REMOVED
}

enum PayoutMethod {
  BANK_TRANSFER
  UPI
}

enum ProjectAllocationStatus {
  DRAFT
  APPROVED
  CANCELLED
}

enum TeamPayoutStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PROCESSING
  PAID
  REJECTED
  FAILED
}

// ─── Platform / Shared ───────────────────────────────────────────────────────

model Organization {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  gstin           String?
  billing_state   String
  billing_address String
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)

  users                  User[]
  client_users           ClientUser[]
  invitation_tokens      InvitationToken[]
  tax_rates              TaxRate[]
  invoice_sequences      InvoiceSequence[]
  credit_note_sequences  CreditNoteSequence[]
  activities             Activity[]
  notes                  Note[]
  documents              Document[]
  notifications          Notification[]
  audit_logs             AuditLog[]
  webhook_events         WebhookEvent[]
  domain_events          DomainEvent[]
  companies              Company[]
  contacts               Contact[]
  leads                  Lead[]
  deals                  Deal[]
  proposals              Proposal[]
  projects               Project[]
  milestones             Milestone[]
  tasks                  Task[]
  time_entries           TimeEntry[]
  invoices               Invoice[]
  invoice_line_items     InvoiceLineItem[]
  payments               Payment[]
  refunds                Refund[]
  credit_notes           CreditNote[]
  credit_note_line_items CreditNoteLineItem[]
  expenses               Expense[]
  forge_fund_entries     ForgeFundEntry[]
  maintenance_contracts  MaintenanceContract[]
  support_tickets        SupportTicket[]
  proposal_line_items    ProposalLineItem[]
  kyc_profiles           KycProfile[]
  kyc_documents          KycDocument[]
  payout_profiles        PayoutProfile[]
  project_allocations       ProjectAllocation[]
  project_allocation_lines  ProjectAllocationLine[]
  team_payout_requests      TeamPayoutRequest[]

  @@map("organizations")
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  email           String
  name            String
  role            UserRole
  password_hash   String?
  active          Boolean   @default(true)
  last_login_at   DateTime? @db.Timestamptz(6)
  /// Set when the user finishes first-run onboarding ("Enter Forge"). Null = not yet onboarded.
  onboarded_at    DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  invitations_created   InvitationToken[] @relation("InvitationCreatedBy")
  activities_created    Activity[]        @relation("ActivityCreatedBy")
  notes_created         Note[]            @relation("NoteCreatedBy")
  documents_uploaded    Document[]        @relation("DocumentUploadedBy")
  deals_owned           Deal[]            @relation("DealOwner")
  proposals_created     Proposal[]        @relation("ProposalCreatedBy")
  projects_owned        Project[]         @relation("ProjectOwner")
  tasks_assigned        Task[]            @relation("TaskAssignee")
  time_entries          TimeEntry[]
  payments_recorded     Payment[]         @relation("PaymentRecordedBy")
  refunds_approved      Refund[]          @relation("RefundApprovedBy")
  credit_notes_approved CreditNote[]      @relation("CreditNoteApprovedBy")
  expenses_recorded     Expense[]         @relation("ExpenseRecordedBy")
  forge_fund_entries    ForgeFundEntry[]  @relation("ForgeFundApprovedBy")
  kyc_profile           KycProfile?
  payout_profile        PayoutProfile?
  project_allocations_created  ProjectAllocation[]     @relation("ProjectAllocationCreatedBy")
  project_allocations_approved ProjectAllocation[]     @relation("ProjectAllocationApprovedBy")
  project_allocation_lines     ProjectAllocationLine[] @relation("ProjectAllocationLineUser")
  team_payout_requests         TeamPayoutRequest[]     @relation("TeamPayoutRequestUser")
  team_payouts_reviewed        TeamPayoutRequest[]     @relation("TeamPayoutReviewedBy")
  team_payouts_approved        TeamPayoutRequest[]     @relation("TeamPayoutApprovedBy")

  @@unique([organization_id, email])
  @@index([organization_id])
  @@map("users")
}

model ClientUser {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  company_id      String    @db.Uuid
  contact_id      String?   @db.Uuid
  email           String
  password_hash   String?
  active          Boolean   @default(true)
  last_login_at   DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  company      Company      @relation(fields: [company_id], references: [id], onDelete: Restrict)
  contact      Contact?     @relation(fields: [contact_id], references: [id], onDelete: SetNull)

  support_tickets SupportTicket[]

  @@unique([organization_id, email])
  @@index([organization_id])
  @@index([company_id])
  @@index([contact_id])
  @@map("client_users")
}

model InvitationToken {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String          @db.Uuid
  token_hash      String          @unique
  scope           InvitationScope
  email           String
  user_role       UserRole?
  company_id      String?         @db.Uuid
  expires_at      DateTime        @db.Timestamptz(6)
  used_at         DateTime?       @db.Timestamptz(6)
  revoked_at      DateTime?       @db.Timestamptz(6)
  created_by      String          @db.Uuid
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  company      Company?     @relation(fields: [company_id], references: [id], onDelete: Restrict)
  creator      User         @relation("InvitationCreatedBy", fields: [created_by], references: [id], onDelete: Restrict)

  @@index([organization_id])
  @@index([company_id])
  @@index([created_by])
  @@map("invitation_tokens")
}

model TaxRate {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  hsn_sac_code    String
  description     String
  cgst_rate       Decimal   @db.Decimal(5, 2)
  sgst_rate       Decimal   @db.Decimal(5, 2)
  igst_rate       Decimal   @db.Decimal(5, 2)
  effective_from  DateTime  @db.Date
  effective_to    DateTime? @db.Date
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)

  organization        Organization       @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  proposal_line_items ProposalLineItem[]

  @@index([organization_id])
  @@index([organization_id, hsn_sac_code])
  @@map("tax_rates")
}

model InvoiceSequence {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  financial_year  String
  last_number     Int      @default(0)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@unique([organization_id, financial_year])
  @@map("invoice_sequences")
}

/// Explicit FY-scoped counter for Credit Notes — never share InvoiceSequence.
model CreditNoteSequence {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  financial_year  String
  last_number     Int      @default(0)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@unique([organization_id, financial_year])
  @@map("credit_note_sequences")
}

model Activity {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  type            String
  summary         String
  occurred_at     DateTime @default(now()) @db.Timestamptz(6)
  company_id      String?  @db.Uuid
  contact_id      String?  @db.Uuid
  deal_id         String?  @db.Uuid
  project_id      String?  @db.Uuid
  created_by      String   @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  company      Company?     @relation(fields: [company_id], references: [id], onDelete: Restrict)
  contact      Contact?     @relation(fields: [contact_id], references: [id], onDelete: Restrict)
  deal         Deal?        @relation(fields: [deal_id], references: [id], onDelete: Restrict)
  project      Project?     @relation(fields: [project_id], references: [id], onDelete: Restrict)
  creator      User         @relation("ActivityCreatedBy", fields: [created_by], references: [id], onDelete: Restrict)

  @@index([organization_id])
  @@index([company_id, occurred_at(sort: Desc)])
  @@index([contact_id, occurred_at(sort: Desc)])
  @@index([deal_id, occurred_at(sort: Desc)])
  @@index([project_id, occurred_at(sort: Desc)])
  @@index([created_by])
  @@map("activities")
}

model Note {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String     @db.Uuid
  body            String     @db.Text
  visibility      Visibility @default(INTERNAL)
  company_id      String?    @db.Uuid
  contact_id      String?    @db.Uuid
  deal_id         String?    @db.Uuid
  project_id      String?    @db.Uuid
  created_by      String     @db.Uuid
  created_at      DateTime   @default(now()) @db.Timestamptz(6)
  updated_at      DateTime   @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  company      Company?     @relation(fields: [company_id], references: [id], onDelete: Restrict)
  contact      Contact?     @relation(fields: [contact_id], references: [id], onDelete: Restrict)
  deal         Deal?        @relation(fields: [deal_id], references: [id], onDelete: Restrict)
  project      Project?     @relation(fields: [project_id], references: [id], onDelete: Restrict)
  creator      User         @relation("NoteCreatedBy", fields: [created_by], references: [id], onDelete: Restrict)

  @@index([organization_id])
  @@index([company_id, created_at(sort: Desc)])
  @@index([contact_id, created_at(sort: Desc)])
  @@index([deal_id, created_at(sort: Desc)])
  @@index([project_id, created_at(sort: Desc)])
  @@index([created_by])
  @@map("notes")
}

model Document {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String           @db.Uuid
  filename        String
  storage_key     String
  mime_type       String
  size_bytes      Int
  category        DocumentCategory
  visibility      Visibility       @default(INTERNAL)
  company_id      String?          @db.Uuid
  contact_id      String?          @db.Uuid
  deal_id         String?          @db.Uuid
  project_id      String?          @db.Uuid
  invoice_id      String?          @db.Uuid
  uploaded_by     String           @db.Uuid
  deleted_at      DateTime?        @db.Timestamptz(6)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  company      Company?     @relation(fields: [company_id], references: [id], onDelete: Restrict)
  contact      Contact?     @relation(fields: [contact_id], references: [id], onDelete: Restrict)
  deal         Deal?        @relation(fields: [deal_id], references: [id], onDelete: Restrict)
  project      Project?     @relation(fields: [project_id], references: [id], onDelete: Restrict)
  invoice      Invoice?     @relation(fields: [invoice_id], references: [id], onDelete: Restrict)
  uploader     User         @relation("DocumentUploadedBy", fields: [uploaded_by], references: [id], onDelete: Restrict)

  @@index([organization_id])
  @@index([company_id, created_at(sort: Desc)])
  @@index([contact_id, created_at(sort: Desc)])
  @@index([deal_id, created_at(sort: Desc)])
  @@index([project_id, created_at(sort: Desc)])
  @@index([invoice_id, created_at(sort: Desc)])
  @@index([uploaded_by])
  @@index([deleted_at])
  @@map("documents")
}

model Notification {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String              @db.Uuid
  recipient_type  RecipientType
  recipient_id    String              @db.Uuid
  type            String
  channel         NotificationChannel
  payload         Json
  read_at         DateTime?           @db.Timestamptz(6)
  created_at      DateTime            @default(now()) @db.Timestamptz(6)
  updated_at      DateTime            @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@index([organization_id])
  @@index([recipient_type, recipient_id, created_at(sort: Desc)])
  @@map("notifications")
}

/// Immutable — no UPDATE/DELETE at DB role level (see prisma/sql/002_audit_log_revoke.sql).
/// No updated_at by design.
model AuditLog {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  actor_type      ActorType
  actor_id        String?   @db.Uuid
  action          String
  entity_type     String
  entity_id       String    @db.Uuid
  before          Json?
  after           Json?
  ip_address      String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@index([organization_id])
  @@index([entity_type, entity_id, created_at(sort: Desc)])
  @@index([actor_type, actor_id])
  @@map("audit_logs")
}

model WebhookEvent {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String        @db.Uuid
  source            WebhookSource
  external_event_id String
  event_type        String
  payload           Json
  status            WebhookStatus @default(RECEIVED)
  processed_at      DateTime?     @db.Timestamptz(6)
  error             String?       @db.Text
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  updated_at        DateTime      @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@unique([organization_id, source, external_event_id])
  @@index([organization_id])
  @@index([status, created_at])
  @@map("webhook_events")
}

model DomainEvent {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String            @db.Uuid
  type            String
  aggregate_type  String
  aggregate_id    String            @db.Uuid
  payload         Json
  status          DomainEventStatus @default(PENDING)
  attempts        Int               @default(0)
  last_error      String?           @db.Text
  processed_at    DateTime?         @db.Timestamptz(6)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@index([organization_id])
  @@index([status, created_at])
  @@map("domain_events")
}

// ─── CRM ─────────────────────────────────────────────────────────────────────

model Company {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  name            String
  gstin           String?
  billing_state   String?
  billing_address String?
  tags            String[]  @default([])
  archived_at     DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  contacts          Contact[]
  client_users      ClientUser[]
  invitation_tokens InvitationToken[]
  leads             Lead[]
  deals             Deal[]
  projects          Project[]
  invoices          Invoice[]
  activities        Activity[]
  notes             Note[]
  documents         Document[]

  @@index([organization_id])
  @@index([archived_at])
  @@map("companies")
}

model Contact {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  company_id      String?   @db.Uuid
  name            String
  email           String?
  phone           String?
  archived_at     DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  company      Company?     @relation(fields: [company_id], references: [id], onDelete: Restrict)

  client_users        ClientUser[]
  leads               Lead[]
  deals               Deal[]
  milestones_approved Milestone[]  @relation("MilestoneApprovedByContact")
  activities          Activity[]
  notes               Note[]
  documents           Document[]

  @@index([organization_id])
  @@index([company_id])
  @@index([archived_at])
  @@map("contacts")
}

model Lead {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id      String     @db.Uuid
  contact_id           String?    @db.Uuid
  company_id           String?    @db.Uuid
  status               LeadStatus @default(NEW)
  source               LeadSource @default(OTHER)
  notes                String?    @db.Text
  converted_to_deal_id String?    @db.Uuid
  archived_at          DateTime?  @db.Timestamptz(6)
  created_at           DateTime   @default(now()) @db.Timestamptz(6)
  updated_at           DateTime   @updatedAt @db.Timestamptz(6)

  organization   Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  contact        Contact?     @relation(fields: [contact_id], references: [id], onDelete: Restrict)
  company        Company?     @relation(fields: [company_id], references: [id], onDelete: Restrict)
  converted_deal Deal?        @relation("LeadConvertedDeal", fields: [converted_to_deal_id], references: [id], onDelete: Restrict)

  @@index([organization_id])
  @@index([contact_id])
  @@index([company_id])
  @@index([converted_to_deal_id])
  @@index([status])
  @@index([archived_at])
  @@map("leads")
}

model Deal {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id       String          @db.Uuid
  title                 String
  company_id            String?         @db.Uuid
  contact_id            String?         @db.Uuid
  stage                 DealStage       @default(NEW)
  estimated_value       Decimal         @db.Decimal(12, 2)
  owner_id              String          @db.Uuid
  lost_reason           DealLostReason?
  next_follow_up_at     DateTime?       @db.Timestamptz(6)
  reopened_from_deal_id String?         @db.Uuid
  archived_at           DateTime?       @db.Timestamptz(6)
  created_at            DateTime        @default(now()) @db.Timestamptz(6)
  updated_at            DateTime        @updatedAt @db.Timestamptz(6)

  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  company         Company?     @relation(fields: [company_id], references: [id], onDelete: Restrict)
  contact         Contact?     @relation(fields: [contact_id], references: [id], onDelete: Restrict)
  owner           User         @relation("DealOwner", fields: [owner_id], references: [id], onDelete: Restrict)
  reopened_from   Deal?        @relation("DealReopenedFrom", fields: [reopened_from_deal_id], references: [id], onDelete: Restrict)
  reopened_deals  Deal[]       @relation("DealReopenedFrom")
