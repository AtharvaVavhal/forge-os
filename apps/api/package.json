{
  "name": "@forge/api",
  "version": "0.1.0",
  "private": true,
  "description": "FORGE Business OS — NestJS API. Phase 0 foundation only: bootstrap, config, Prisma wiring, health checks, error envelope, request-id/logging, CORS, security-header/cookie/CSRF boundaries. No domain modules (auth/crm/sales/projects/finance/team/portal/shared) are implemented yet — see docs/IMPLEMENTATION-PHASE-0.md.",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.787.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.7.0",
    "@prisma/client": "^6.16.1",
    "bcryptjs": "2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.0.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.28.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "jest": "^30.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.70.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "setupFiles": [
      "reflect-metadata",
      "<rootDir>/../test/support/mock-r2.ts",
      "<rootDir>/../test/support/mock-resend.ts"
    ],
    "moduleNameMapper": {
      "^@aws-sdk/client-s3$": "<rootDir>/../test/__mocks__/@aws-sdk/client-s3.ts",
      "^@aws-sdk/s3-request-presigner$": "<rootDir>/../test/__mocks__/@aws-sdk/s3-request-presigner.ts",
      "^resend$": "<rootDir>/../test/__mocks__/resend.ts"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
