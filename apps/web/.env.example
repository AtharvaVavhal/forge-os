# FORGE Business OS — apps/web environment variables.
#
# Backend (DATABASE_URL, APP_DB_ROLE, PORT, CORS_ORIGINS, etc.) lives in the
# repo-root .env.example, not here — apps/web never talks to Postgres
# directly, only to the API over HTTP.

# Browser-exposed (NEXT_PUBLIC_*) — safe to ship in the client bundle.
# The typed API client (src/lib/api/client.ts) falls back to
# http://localhost:4000/api/v1 if this is unset, matching apps/api's
# Phase 0 default PORT.
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api/v1"
