# FORGE Business OS — apps/web environment variables.
#
# Backend (DATABASE_URL, APP_DB_ROLE, PORT, CORS_ORIGINS, etc.) lives in the
# repo-root .env.example, not here — apps/web never talks to Postgres
# directly, only to the API over HTTP.

# Server-side session reads and the Next.js `/api/v1/*` rewrite target.
# The browser talks same-origin to `/api/v1` so the httpOnly `forge_session`
# cookie stays first-party (Document 6 §5). Do not put tokens in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api/v1"
