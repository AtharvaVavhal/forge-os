# FORGE Business OS — apps/web environment variables.
#
# Backend secrets (DATABASE_URL, SESSION_JWT_SIGNING_KEY, RESEND_*, R2_*,
# RAZORPAY_*, GOOGLE_OAUTH_*) live in the repo-root .env.example — never here.
# Do not invent NEXT_PUBLIC_* secrets. The browser only talks to Forge via
# same-origin `/api/v1` (rewritten to the Nest API).

# REQUIRED for production builds and rewrites.
# Absolute Nest API base including the frozen `/api/v1` prefix.
# Used by:
#   - Next.js rewrite: /api/v1/* → {origin}/api/v1/*
#   - CSP connect-src allowlist
#   - Server Components / RSC session reads (fail-closed if missing in production)
#
# Local development:
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api/v1"
#
# Staging / production example (HTTPS, no localhost):
# NEXT_PUBLIC_API_BASE_URL="https://api.forgebuilds.in/api/v1"
#
# Browser fetches always use `${window.location.origin}/api/v1` so cookies stay
# first-party (SameSite=Strict). Do not point the browser at a cross-origin API.
